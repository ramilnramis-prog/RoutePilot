# RoutePilot configuration example.
# Copy to .env and adjust. Never commit a real .env file (see .gitignore).

# doctor behaviour: dev = warn on missing tzdata, strict = fail (CI / release checks)
ROUTEPILOT_DOCTOR_MODE=dev

# IANA time zone applied to new route plans (per-plan value is authoritative)
ROUTEPILOT_DEFAULT_TIMEZONE=Europe/Moscow

# Optional: path to a compiled IANA tz database (TZif) tree, e.g. a system zoneinfo.
# Only needed when the `tzdata` package cannot be installed. Leave empty normally.
PYTHONTZPATH=

# Storage (`ROUTEPILOT_DB_PATH` is not consumed yet; the Stage 3 repositories take the database
# path from their caller and no database file is committed - D38)
ROUTEPILOT_DB_PATH=var/routepilot.sqlite3

# Provenance of travel time / distance data.
# DEMO_SYNTHETIC must never be presented as real road routing.
ROUTEPILOT_DATA_PROVENANCE=DEMO_SYNTHETIC

# Map tiles for the demo UI (config-isolated; core must never depend on a tile vendor).
# Attribution must remain visible in the UI.
ROUTEPILOT_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
ROUTEPILOT_TILE_ATTRIBUTION=(c) OpenStreetMap contributors
ROUTEPILOT_TILE_MAX_ZOOM=19
